# Copier ce fichier en .env (jamais commité) puis renseigner les clés.
# Le fichier .env est chargé automatiquement au lancement.
OPENAI_API_KEY=
PIPELEX_API_KEY=
# Modèle OpenAI du colleur, de l'analyse et de l'évaluation locale.
OPENAI_MODEL=gpt-4.1-mini
# Valeur secrète stable pour garder les sessions après un redémarrage.
FLASK_SECRET_KEY=
# Évaluation pendant la colle : local (méthode .mthds exécutée via OpenAI, 1 à 3 s)
# ou pipelex (API Pipelex, 7 à 20 s par réponse).
COLLE_EVALUATEUR=local
# Durée d'une colle, en minutes.
COLLE_DUREE_MINUTES=30
# Modalités optionnelles : Gradium seul pour transcription/synthèse, sans Gradbot.
GRADIUM_API_KEY=
# Facultatif : identifiant d'une voix française Gradium (Gaspard par défaut).
KHOLLEUR_VOICE_ID=
# Reconnaissance manuscrite seule, sans évaluation ni correction.
VISION_MODEL=gpt-4.1-mini
