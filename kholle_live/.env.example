# Voix (lus par gradbot)
GRADIUM_API_KEY=
# Vide : on prend OPENAI_API_KEY.
LLM_API_KEY=
# Un modèle rapide, ex. gpt-4.1-mini.
LLM_MODEL= gpt-4.1
# LLM_BASE_URL=
# Modèle à raisonnement (gpt-5-mini…) : le réduire au minimum pour la latence.
# LLM__EXTRA_CONFIG={"reasoning_effort": "minimal"}

# Lecture du tableau et compte-rendu
OPENAI_API_KEY=
VISION_MODEL=gpt-4.1-mini

# Compte-rendu : pipelex/compte_rendu.mthds sur l'API Pipelex, repli OpenAI (REPORT_MODEL) au-delà de PIPELEX_TIMEOUT_S.
# Clés absentes ici : lues dans le .env de la racine.
PIPELEX_API_KEY=
REPORT_ENGINE=pipelex
REPORT_MODEL=gpt-5.4
PIPELEX_TIMEOUT_S=19

# Voix du khôlleur ; vide : iEu63s1rhn_kegTr (Gaspard, fr, reprise de la démo fantasy_shop)
KHOLLEUR_VOICE_ID=
# Relance du khôlleur après un silence (pas la fin de tour).
SILENCE_TIMEOUT_S=10

# Transcription (voir RUN.md) : poids du vocabulaire mathématique (main.VOCABULAIRE), -6 à 6.
STT_KEYWORDS_BOOST=3
# Vide : 10 trames de 80 ms (défaut Gradium).
STT_DELAY_FRAMES=
# Fin de tour : non réglable dans gradbot 0.2.0 (VAD Gradium, horizon 2 s, seuil 0.8, codé en dur).
# Silence envoyé pour vider la transcription après la fin de tour, défaut 0.5 s.
# STT__FLUSH_DURATION_S=0.5
